{
  "name": "gucc-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 8080",
    "build": "vite build && node scripts/static-redirects.mjs",
    "build:static": "npm run build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:contact": "node --experimental-strip-types --test tests/contact-submit.test.ts",
    "test:contact:ui": "node tests/contact-form.mjs",
    "format": "prettier --write src",
    "test:markets": "node --experimental-strip-types --test tests/tradingview.test.ts",
    "test:markets:ui": "node tests/tradingview-ui.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "~1.168.60",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^0.510.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "three": "^0.186.1",
    "tw-animate-css": "^1.3.4",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright": "^1.62.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.0"
  }
}
